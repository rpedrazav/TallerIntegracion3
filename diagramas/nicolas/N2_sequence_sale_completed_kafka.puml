@startuml N2_sequence_sale_completed_kafka
!theme plain
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam maxMessageSize 220
skinparam BoxPadding 10
skinparam ParticipantPadding 20
skinparam responseMessageBelowArrow true

title N2 — Diagrama de Secuencia: Flujo del Evento sale.completed End-to-End

participant "POS & Cart\nService" as POS #FDEBD0
queue "Kafka Broker\n(topic: sale.completed)" as KAFKA #E8F8F5
participant "Warehouse Service\n(Consumer)" as WH #D5F5E3
database "PostgreSQL\npostgres-warehouse" as WHDB #DCE6F1
participant "Analytics Service\n(Consumer)" as AN #EBF5FB
database "PostgreSQL\npostgres-analytics" as ANDB #DCE6F1
participant "Tax & Compliance\n(Consumer)" as TAX #FADBD8
database "PostgreSQL\npostgres-tax" as TAXDB #DCE6F1
queue "Dead-Letter\nQueue (DLQ)" as DLQ #F5B7B1

autonumber "<b>0."

== 1. Publicación del evento ==

POS -> POS : completar venta\n(cobro, boleta emitida)
activate POS
POS -> KAFKA : **publish** sale.completed\n{ventaId, items[], total, tenantId}
deactivate POS
note right of KAFKA
  Payload completo:
  ventaId, items[] (productoId, cantidad, loteId),
  total, tenantId, sucursalId, timestamp
end note

== 2 y 3. Warehouse Consumer — descuento de stock + regla FEFO ==

KAFKA -> WH : consume sale.completed
activate WH

alt Procesamiento exitoso
    WH -> WH : validar payload del evento
    WH -> WHDB : SELECT lote FEFO\n(fecha_vencimiento ASC)
    activate WHDB
    WHDB --> WH : lote_id más próximo a vencer
    deactivate WHDB

    WH -> WHDB : UPDATE stock_actual\n(descuento por producto y lote)
    activate WHDB
    WHDB --> WH : stock actualizado
    deactivate WHDB

    WH -> WH : evaluar stock_actual < stock_minimo ?

    opt stock_actual < stock_minimo
        WH -> KAFKA : **publish** stock.low\n{productId, stockActual, stockMinimo}
    end

    WH -> KAFKA : **ack** offset commit
else Falla el procesamiento (ej. producto/lote no encontrado, timeout BD)
    WH -> WH : capturar excepción
    WH -> DLQ : **publish** sale.completed (fallido)\n{payload original, error, retry_count, timestamp}
    note right of DLQ
      Se reintenta hasta N veces
      (ej. 3 reintentos con backoff).
      Si sigue fallando, queda en DLQ
      para revisión manual/alerta al equipo.
    end note
    WH -> KAFKA : **ack** offset commit\n(evita bloquear el consumer group)
end
deactivate WH

== 4 y 5. Analytics Consumer — métricas y alertas ==

KAFKA -> AN : consume sale.completed
activate AN

alt Procesamiento exitoso
    AN -> ANDB : UPDATE metricas_ventas\n(totales del día)
    activate ANDB
    ANDB --> AN : ok
    deactivate ANDB

    AN -> AN : recalcular promedio_movil_7d

    AN -> KAFKA : consume stock.low\n(si fue publicado en el paso anterior)
    opt evento stock.low recibido
        AN -> ANDB : INSERT alerta_generada
        activate ANDB
        AN -> ANDB : INSERT notificacion\n(destinatario: Administrador)
        ANDB --> AN : ok
        deactivate ANDB
    end

    AN -> KAFKA : **ack** offset commit
else Falla el procesamiento
    AN -> AN : capturar excepción
    AN -> DLQ : **publish** sale.completed (fallido)\n{payload original, error, retry_count}
    AN -> KAFKA : **ack** offset commit
end
deactivate AN

== 6. Tax Consumer — auditoría tributaria ==

KAFKA -> TAX : consume sale.completed
activate TAX

alt Procesamiento exitoso
    TAX -> TAX : validar payload\n(items, total, tenantId)
    TAX -> TAXDB : INSERT calculos_impuesto\n(registro de auditoría tributaria)
    activate TAXDB
    TAXDB --> TAX : ok
    deactivate TAXDB
    TAX -> KAFKA : **ack** offset commit
else Falla el procesamiento
    TAX -> TAX : capturar excepción
    TAX -> DLQ : **publish** sale.completed (fallido)\n{payload original, error, retry_count}
    TAX -> KAFKA : **ack** offset commit
end
deactivate TAX

note over KAFKA, DLQ
  **Manejo de errores:** cada consumer procesa el evento de forma independiente
  (aislamiento entre consumer groups). Un fallo en un servicio NO bloquea a los demás
  ni al productor. Los mensajes fallidos van a la DLQ tras agotar reintentos, quedando
  disponibles para reprocesamiento manual o alerta al equipo de DevOps.
end note

@enduml
