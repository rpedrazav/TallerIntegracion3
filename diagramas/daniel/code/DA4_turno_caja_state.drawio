    </mxCell>

    <mxCell id="e4" value="diferencia detectada,&#10;requiere aprobación ADMINISTRADOR" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="pendiente" target="enrevision">
      <mxGeometry relative="1" as="geometry" />
