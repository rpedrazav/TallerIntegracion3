<mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title -->
    <mxCell id="title1" value="Ciclo de Vida de un Turno de Caja" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="240" y="10" width="400" height="30" as="geometry" />
    </mxCell>

    <!-- Start pseudostate -->
    <mxCell id="start1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="390" y="60" width="20" height="20" as="geometry" />
    </mxCell>

    <!-- ABIERTO -->
    <mxCell id="abierto" value="ABIERTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E6B3;strokeColor=#444444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="320" y="120" width="160" height="60" as="geometry" />
    </mxCell>

    <!-- EN_USO -->
    <mxCell id="enuso" value="EN_USO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3D9FF;strokeColor=#444444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="320" y="240" width="160" height="60" as="geometry" />
    </mxCell>

    <!-- PENDIENTE_CIERRE -->
    <mxCell id="pendiente" value="PENDIENTE_CIERRE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE699;strokeColor=#444444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="300" y="360" width="200" height="60" as="geometry" />
    </mxCell>

    <!-- EN_REVISION -->
    <mxCell id="enrevision" value="EN_REVISION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFB3B3;strokeColor=#444444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="80" y="500" width="180" height="60" as="geometry" />
    </mxCell>

    <!-- CERRADO -->
    <mxCell id="cerrado" value="CERRADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#444444;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="560" y="500" width="160" height="60" as="geometry" />
    </mxCell>

    <!-- End pseudostate (outer ring) -->
    <mxCell id="end1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
      <mxGeometry x="628" y="610" width="24" height="24" as="geometry" />
    </mxCell>
    <!-- End pseudostate (inner dot) -->
    <mxCell id="end1inner" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
      <mxGeometry x="634" y="616" width="12" height="12" as="geometry" />
    </mxCell>

    <!-- Invariant note -->
    <mxCell id="note1" value="INVARIANTE&#10;Un cajero solo puede tener UN turno&#10;ABIERTO / EN_USO a la vez, por sucursal.&#10;(no se puede abrir un 2do turno si ya&#10;existe uno activo en esa sucursal)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#444444;size=16;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="600" y="100" width="240" height="100" as="geometry" />
    </mxCell>

    <!-- Edges -->
    <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="start1" target="abierto">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e1" value="primera venta registrada" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="abierto" target="enuso">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" value="cajero solicita cierre + cuadre" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;" edge="1" parent="1" source="enuso" target="pendiente">
