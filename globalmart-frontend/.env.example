# ==============================================================================
# GlobalMart OS — Frontend Environment Variables Template (S3-026)
# ==============================================================================
# Modos soportados en la variable única API_MODE:
#   - 'remote' : Ingress del clúster en dev.censei.cl (por defecto)
#   - 'local'  : Docker Compose vía Kong API Gateway (http://localhost:8000/api)
# ==============================================================================

API_MODE=remote

# Terminal de pago del frontend (leído en main desde process.env).
# 'mock' usa el simulador TerminalPort; 'real' usa el adaptador HTTP de MS-5.
DEVICE_TERMINAL_MODE=mock

# Escenario determinista: waiting | approved | declined | cancelled | disconnected
MOCK_TERMINAL_SCENARIO=approved

# Espera del simulador antes de resolver approved/declined/disconnected.
MOCK_TERMINAL_DELAY_MS=400

# Compatibilidad: solo se usa como fallback cuando MOCK_TERMINAL_SCENARIO no está definido.
AUTO_APPROVE_MOCK=false
