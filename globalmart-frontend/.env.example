# ==============================================================================
# GlobalMart OS — Frontend Environment Variables Template
# Tarea: TI3-659 (Plan ID: S2-028)
# ==============================================================================
# Copie este archivo como .env para personalizar los destinos de APIs.
#
# Modos soportados en API_MODE:
#   - 'remote'  : Conecta a los microservicios desplegados en dev.censei.cl (Default)
#   - 'gateway' : Enruta todo a través de Kong API Gateway (http://localhost:8000)
#   - 'local'   : Conecta directamente a los puertos de desarrollo local de cada API
# ==============================================================================

# Modo de conexión general ('remote' | 'gateway' | 'local')
API_MODE=remote

# URL base de Kong API Gateway (usado cuando API_MODE=gateway)
GATEWAY_URL=http://localhost:8000

# Overrides individuales para endpoints de microservicios (opcionales)
# Si se definen, tienen prioridad sobre los defaults del modo seleccionado.
#
# MS-1: Tenant & Identity Service (Dev Host :5124)
IDENTITY_API_URL=https://auth-rpedraza.dev.censei.cl
# IDENTITY_API_URL=http://localhost:5124

# MS-3: Catalog & Pricing Service (Dev Host :5203)
CATALOG_API_URL=https://catalog-rpedraza.dev.censei.cl
# CATALOG_API_URL=http://localhost:5203

# MS-5: POS & Cart Service (Dev Host :5000)
POS_API_URL=https://pos-rpedraza.dev.censei.cl
# POS_API_URL=http://localhost:5000
