<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)/obj/</MSBuildProjectExtensionsPath>
    <ImportProjectExtensionProps>false</ImportProjectExtensionProps>
    <ImportProjectExtensionTargets>false</ImportProjectExtensionTargets>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)/obj/$(MSBuildProjectFile).nuget.g.props"
          Condition="Exists('$(MSBuildProjectDirectory)/obj/$(MSBuildProjectFile).nuget.g.props')" />
</Project>