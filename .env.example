# ==============================================================================
# GlobalMart OS — Plantilla Principal de Variables de Entorno (.env.example)
#
# Tareas de referencia:
#   - TI3-659 (S2-028): Parametrización de destinos de frontend
#   - TI3-661 (S2-030): Arranque reproducible del núcleo
#   - TI3-687 (S2-056): Configuración segura del simulador de pagos
#
# INSTRUCCIONES:
#   Copiar este archivo o los específicos de cada módulo según corresponda:
#     - Para Docker / Infraestructura: cp Docker/env.example Docker/.env
#     - Para Frontend Electron:        cp globalmart-frontend/.env.example globalmart-frontend/.env
#
# ADVERTENCIA DE SEGURIDAD (RN-02 / RN-07):
#   - NUNCA commitear archivos .env con credenciales reales al repositorio git.
#   - NUNCA almacenar ni procesar números de tarjetas de crédito/débito reales (PCI DSS).
#   - En producción, los secretos se inyectan dinámicamente vía Azure Key Vault,
#     AWS Secrets Manager o variables de entorno de orquestación (Kubernetes).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASES DE DATOS POSTGRESQL (8 INSTANCIAS)
# ------------------------------------------------------------------------------
DB_USER=admin
DB_PASSWORD=admin_password

# ------------------------------------------------------------------------------
# 2. APACHE KAFKA & ZOOKEEPER
# ------------------------------------------------------------------------------
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_HOST=localhost
KAFDROP_PORT=9000

# ------------------------------------------------------------------------------
# 3. KONG API GATEWAY
# ------------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ------------------------------------------------------------------------------
# 4. MONITOREO Y OBSERVABILIDAD
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 5. AUTENTICACIÓN Y SEGURIDAD JWT (RN-07)
# ------------------------------------------------------------------------------
# Clave secreta simétrica HMAC-SHA256 (mínimo 32 caracteres) para firma de JWT
JWT_SECRET_KEY=GlobalMartOS_SuperSecretKey_ChangeInProduction_Min32Chars!!

# ------------------------------------------------------------------------------
# 6. PASARELA DE PAGO Y SIMULADOR (RN-02 / S2-056 / TI3-687)
# ------------------------------------------------------------------------------
# Entorno de ejecución de la pasarela: 'sandbox' o 'production'
PASARELA_ENVIRONMENT=sandbox

# URL base del endpoint de pasarela/simulador (terminada o no con /)
# En desarrollo: sandbox simulada o mock HTTP
# En producción: endpoint HTTPS oficial de Transbank / Stripe / MercadoPago
PASARELA_BASE_URL=https://api.sandbox-pasarela.example.com

# Timeout en segundos para la llamada HTTP hacia la pasarela
# Para validar escenarios de timeout (sim-timeout-v1 demora 35s), se fija en 30s
PASARELA_TIMEOUT_SECONDS=30

# Clave de API para el simulador (valor de prueba/dummy, nunca clave real)
PASARELA_API_KEY=sim_key_dummy_test_only

# Escenario predeterminado para pruebas automáticas
# Opciones disponibles en simulador: sim-approved-v1 | sim-declined-v1 | sim-timeout-v1
PASARELA_DEFAULT_SCENARIO=sim-approved-v1

# Overrides jerárquicos estándar para ASP.NET Core (MS-5 POSCartService)
PasarelaPago__BaseUrl=https://api.sandbox-pasarela.example.com
PasarelaPago__TimeoutSeconds=30
PasarelaPago__ApiKey=sim_key_dummy_test_only
PasarelaPago__Environment=sandbox

# ------------------------------------------------------------------------------
# 7. FRONTEND ELECTRON & REACT (S2-028 / TI3-659)
# ------------------------------------------------------------------------------
# Modo de conexión general ('remote' | 'gateway' | 'local')
API_MODE=remote

# URL base de Kong API Gateway (usado cuando API_MODE=gateway)
GATEWAY_URL=http://localhost:8000

# Overrides de servicios individuales (opcionales)
IDENTITY_API_URL=https://auth-rpedraza.dev.censei.cl
CATALOG_API_URL=https://catalog-rpedraza.dev.censei.cl
POS_API_URL=https://pos-rpedraza.dev.censei.cl
